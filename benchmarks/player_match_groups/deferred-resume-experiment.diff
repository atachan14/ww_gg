+    certificates=tuple(ProfileCertificate(tuple((i,values[i])for i in infos),tuple((i,scores[i])for i in infos))for values,scores in checkpoint['states'])
+    status='multiple'if len(certificates)>1 else'unique'if certificates else'no_admissible_profile'
+    return ProfileSearch(status,total,total,certificates,proof='dependency_elimination_resume')
