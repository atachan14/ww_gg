+        return ProfileSearch('undefined_observations'if undefined else'dependency_unfinished',total,0,issues=(ProfileIssue(profile,'undefined_observation'if undefined else'unresolved_dependency',error.reason),),reason=error.reason,proof='dependency_elimination_resume')
+    except CalculationBudgetExceeded:
